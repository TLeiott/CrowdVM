#!/usr/bin/env sh
# nightly and stable only change through scripts/release/release.sh, which
# fast-forwards them from main and nightly. A plain push to them is refused.
[ "${CROWDVM_RELEASE:-}" = 1 ] && exit 0
while read -r _local _sha remote_ref _rsha; do
  case "$remote_ref" in
    refs/heads/nightly|refs/heads/stable)
      echo "pre-push: ${remote_ref#refs/heads/} is only updated by a release: run scripts/release/release.sh ${remote_ref#refs/heads/} (or make release-${remote_ref#refs/heads/})" >&2
      exit 1 ;;
  esac
done
exit 0
